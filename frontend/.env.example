NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Runtime event delivery. NEXT_PUBLIC_SENTRY_DSN is intentionally public and
# must be available while Next.js builds the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Optional build-only credentials for release creation and source-map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
